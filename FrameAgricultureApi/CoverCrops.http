@baseUrl = http://localhost:8085

### Calculate cover crop emissions
# cropType: 10 = Wheat (see FrameAgricultureApi.Libraries.CoverCrops/CropType.cs)
# coverCropType: 0 = All (the only supported cover crop type)
POST {{baseUrl}}/api/cover-crops/cover-crop-emissions?api-version=0.0
Content-Type: application/json
Accept: application/json

{
  "cropType": 10,
  "coverCropType": 0
}